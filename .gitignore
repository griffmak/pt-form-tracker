node_modules/
dist/
test-results/
# Archived captures are tracked: they are the evidence base for the measurement
# rebuild and the corpus later phases validate against, and re-recording is
# expensive because tracking quality varies unpredictably between sessions.
# latest.json stays ignored — every dev session overwrites it.
.claude-test-artifacts/*
!.claude-test-artifacts/session-*.json
!.claude-test-artifacts/corpus-*.json
.vercel
